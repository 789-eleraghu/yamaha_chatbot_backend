# ==========================================
# Yamaha Energy AI Assistant Backend Configuration
# ==========================================

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# SQLite configuration (used for local mock data)
SQLITE_DB_PATH=yamaha_mock.db

# ClickHouse configuration (for production)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=yamaha
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ------------------------------------------
# AWS Bedrock Configuration
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Optional: if using temporary session tokens (e.g. AWS SSO / IAM Role)
# AWS_SESSION_TOKEN=your_aws_session_token

# Bedrock Model Selection
# Examples:
# - anthropic.claude-3-5-sonnet-20241022-v2:0
# - anthropic.claude-3-haiku-20240307-v1:0
# - amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TEMPERATURE=0.0
BEDROCK_MAX_TOKENS=4096

# ------------------------------------------
# LangChain / LangSmith Observability
# ------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=yamaha-energy-chatbot
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
